# ULTRA Algorithmic Trading Platform - Environment Configuration
# Copy this file to .env and fill in your credentials

# Deriv API Credentials
DERIV_APP_ID=1089
# Public market data (paper mode) works without a token.
# For LIVE trading, put your real API token here: https://deriv.com/account/api-token
DERIV_API_TOKEN=

# Trading Mode: paper | live | backtest
TRADING_MODE=paper

# Log Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Database
DB_PATH=data/ultra.db

# Optional: Alert notifications
# ALERT_EMAIL=your@email.com
# WEBHOOK_URL=https://hooks.slack.com/your/webhook
